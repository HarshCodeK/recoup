# Real LLM provider via kilo / OpenAI-compatible gateway
# Copy this file to .env and fill in your values.
# Recoup reads these at the call site of `OpenAICompatibleProvider`.

# Gateway base URL (must end with /v1). kilo example shown.
OPENAI_BASE_URL=https://api.kilo.ai/api/gateway/v1
OPENAI_API_KEY=your_kilo_key_here
# The ":free" tier model is what this repo's eval was wired against.
OPENAI_MODEL=poolside/laguna-s-2.1:free
# Alternative free models on kilo that also work (slower / noisier):
#   nvidia/nemotron-3-super-120b-a12b:free
#   kilo-auto/free

# Optional: override the persistent audit-store location.
# RECOUP_AUDIT_DB=./.recoup/audit.db

# Optional: set if you want to use Anthropic instead of the OpenAI-compatible
# route. The OpenAI route is checked first.
# ANTHROPIC_API_KEY=your_anthropic_key